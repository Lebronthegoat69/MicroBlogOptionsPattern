
@page "{id:int}"
@model MicroBlog.Pages.DetailsModel

@{
    ViewData["Title"] = "Post Details";
}

<h1>Post Details</h1>

@if (Model.BlogPost != null)
{
    <article class="card p-4 mb-4">
        <h2>@Model.BlogPost.Title</h2>

        <p>@Model.BlogPost.Content</p>

        @if (!string.IsNullOrWhiteSpace(Model.BlogPost.Author))
        {
            <p class="text-muted">
                Posted by @Model.BlogPost.Author
            </p>
        }
    </article>

    @if (Model.EnableComments)
    {
        <section class="mt-4">
            <h3>Leave Comment</h3>

            <form method="post">
                <div class="mb-3">
                    <label for="comment" class="form-label">
                        Your comment
                    </label>

                    <textarea id="comment"
                              name="comment"
                              class="form-control"
                              rows="4"
                              required></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    Submit Comment
                </button>
            </form>
        </section>
    }
}